src/formal/build/

# Imported OCaml/Dune build products
src/dth_ocaml/_build/
src/dth_ocaml/_opam/
src/dth_ocaml/_coverage/
src/dth_ocaml/bisect*.coverage

# Generated media
*.png
# Character sprites are source art, not generated output: the browser front end
# and the terminal scene both read them, and a fresh clone without them renders
# labelled placeholders instead of a game.
!art/sprites/**/*.png
# The chapter's rules spread is source art too: the browser's opening slide.
!art/panels/stl_rules.png
# The prepared-frame cache stays derived — its filenames carry a pipeline hash.
art/.sprite-cache/

# Browser app: client dependencies and build, and the Vercel bundle. The
# unanchored outputs/ and .vercel patterns cover src/browser/outputs/ and the
# project link in src/browser/.vercel/.
src/browser/webclient/node_modules/
src/browser/webclient/dist/
src/browser/build/
# The Vercel bundle from before the browser app left src/arena/. Remove this
# line when that directory is deleted.
src/arena/web/build/

# OS/editor noise
.DS_Store
Thumbs.db

# Local AI/tooling metadata
/.codex
/.agents
.vercel
.env*
