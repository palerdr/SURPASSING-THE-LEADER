*.py[cod]
*.so
target/

# Virtualenvs / local tooling
.venv/
.python-version
.tools/
.vscode/

# Test / tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated reports and experiment outputs
outputs/
graphify-out/
multirun/
logs/
demos/
tmp/
paper/build/
src/stl/outputs/
src/dth/outputs/
src/abstract/outputs/

# Training artifacts
models/
checkpoints/
src/stl/checkpoints/
src/dth/artifacts/
src/dth/checkpoints/

# Imported OCaml/Dune build products
src/dth_ocaml/_build/
src/dth_ocaml/_opam/
src/dth_ocaml/_coverage/
src/dth_ocaml/bisect*.coverage

# Generated media
*.png
# Character sprites are source art, not generated output: the browser front end
# and the terminal scene both read them, and a fresh clone without them renders
# labelled placeholders instead of a game.
!art/sprites/**/*.png
# The prepared-frame cache stays derived — its filenames carry a pipeline hash.
art/.sprite-cache/

# Browser front end
src/arena/webclient/node_modules/
src/arena/webclient/dist/

# OS/editor noise
.DS_Store
Thumbs.db

# Local AI/tooling metadata
/.codex
/.agents
